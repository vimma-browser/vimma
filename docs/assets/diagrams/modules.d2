# Generated by npm run diagrams from the imports under src/browser/base/content/vimma/
# (tools/diagrams/module-graph.ts). Do not edit: change the code, then regenerate.

direction: down

classes: {
  folder: {
    style: { fill: ${box}; stroke: ${box-line}; font-color: ${text}; font-size: 16; border-radius: 6 }
  }
  cycle-group: {
    label.near: outside-top-left
    style: { fill: ${cycle-fill}; stroke: ${cycle}; stroke-dash: 4; font-color: ${cycle}; font-size: 15; border-radius: 8 }
  }
  eager: { style: { stroke: ${line}; stroke-width: 1 } }
  lazy: { style: { stroke: ${muted}; stroke-dash: 4 } }
  cycle-edge: { style: { stroke: ${cycle}; stroke-width: 2 } }
  legend: { shape: text; near: bottom-center; style: { font-color: ${muted}; font-size: 15 } }
}

cycle1: "Eager import cycle: 6 folders" {
  class: cycle-group
  about: "about/" { class: folder }
  actors: "actors/" { class: folder }
  config: "config/" { class: folder }
  ctl: "ctl/" { class: folder }
  host: "host/" { class: folder }
  workspaces: "workspaces/" { class: folder }
}
agent: "agent/" { class: folder }
omarchy: "omarchy/" { class: folder }
search: "search/" { class: folder }
services: "services/" { class: folder }
setup: "setup/" { class: folder }
split: "split/" { class: folder }
start: "start/" { class: folder }
ui: "ui/" { class: folder }
updates: "updates/" { class: folder }

cycle1.about -> cycle1.config { class: cycle-edge }
cycle1.about -> cycle1.ctl { class: cycle-edge }
cycle1.about -> cycle1.host { class: cycle-edge }
cycle1 -> search { class: eager }
cycle1 -> split { class: eager }
cycle1 -> ui { class: eager }
cycle1 -> updates { class: eager }
cycle1.about -> cycle1.workspaces { class: cycle-edge }
cycle1.actors -> cycle1.host { class: cycle-edge }
agent -> cycle1.ctl { class: eager }
agent -> cycle1.host { class: eager }
cycle1.config -> cycle1.host { class: cycle-edge }
cycle1.config -> cycle1.workspaces { class: cycle-edge }
cycle1.ctl -> cycle1.actors { class: cycle-edge }
cycle1.ctl -> cycle1.host { class: cycle-edge }
cycle1.ctl -> cycle1.workspaces { class: cycle-edge }
cycle1.host -> cycle1.about { class: cycle-edge }
cycle1.host -> cycle1.actors { class: cycle-edge }
agent <- cycle1.host { class: lazy }
cycle1.config <- cycle1.host { class: lazy }
cycle1.host -> cycle1.ctl { class: cycle-edge }
cycle1.host -> cycle1.workspaces { class: cycle-edge }
ui <- omarchy { class: lazy }
setup -> cycle1.config { class: eager }
setup -> ui { class: eager }
start -> ui { class: eager }
agent <- ui { class: lazy }
cycle1.config <- ui { class: lazy }
cycle1.host <- ui { class: lazy }
cycle1.workspaces -> cycle1.host { class: cycle-edge }

legend: "An arrow points from a folder to one it imports.\nSolid: eager, the import loads with the module.\nDashed: lazy, a getter or a call loads it later.\nAn arrow from a cycle's box: two or more of its folders import that folder.\nvimma.js imports every folder drawn here.\ncore/ is imported by every folder drawn here except omarchy/ and start/." { class: legend }
