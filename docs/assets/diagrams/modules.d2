# Generated by npm run diagrams from the imports under src/browser/base/content/vimma/
# (tools/diagrams/module-graph.ts). Do not edit: change the code, then regenerate.

direction: down

classes: {
  band: {
    label.near: outside-top-left
    style: { fill: ${zone-app}; stroke: ${box-line}; stroke-dash: 4; font-color: ${muted}; font-size: 16; border-radius: 8 }
  }
  folder: {
    style: { fill: ${bg}; stroke: ${box-line}; font-color: ${text}; font-size: 18; border-radius: 6 }
  }
  order: { style: { opacity: 0 } }
  down: { style: { stroke: ${line}; stroke-width: 1 } }
  down-lazy: { style: { stroke: ${line}; stroke-dash: 4 } }
  up: { style: { stroke: ${cycle}; stroke-width: 2 } }
  up-lazy: { style: { stroke: ${cycle}; stroke-width: 2; stroke-dash: 4 } }
  legend: { shape: text; near: bottom-center; style: { font-color: ${muted}; font-size: 17 } }
}

about: "about/ · 6" { class: folder }
omarchy: "omarchy/ · 6" { class: folder }
setup: "setup/ · 6" { class: folder }
start: "start/ · 6" { class: folder }
agent: "agent/ · 5" { class: folder }
config: "config/ · 4" { class: folder }
ctl: "ctl/ · 4" { class: folder }
host: "host/ · 3" { class: folder }
actors: "actors/ · 2" { class: folder }
workspaces: "workspaces/ · 2" { class: folder }
layer1: "Layer 1" {
  class: band
  search: "search/ · 1" { class: folder }
  services: "services/ · 1" { class: folder }
  split: "split/ · 1" { class: folder }
  ui: "ui/ · 1" { class: folder }
  updates: "updates/ · 1" { class: folder }
}

about -> agent { class: order }
actors -> layer1 { class: order }
omarchy -> agent { class: order }
setup -> agent { class: order }
start -> agent { class: order }

about -> config { class: down }
about -> ctl { class: down }
about -> host { class: down }
about -> layer1: "4" { class: down }
about -> workspaces { class: down }
host <- actors { class: up }
agent -> ctl { class: down }
agent -> host { class: down }
config -> host { class: down }
config -> layer1: "4" { class: down }
config -> workspaces { class: down }
ctl -> actors { class: down }
ctl -> host { class: down }
ctl -> layer1: "3" { class: down }
ctl -> workspaces { class: down }
about <- host { class: up }
host -> actors { class: down }
agent <- host { class: up-lazy }
config <- host { class: up-lazy }
ctl <- host { class: up }
host -> layer1: "4" { class: down }
host -> workspaces { class: down }
omarchy -> layer1.ui { class: down-lazy }
setup -> config { class: down }
setup -> layer1.ui { class: down }
start -> layer1.ui { class: down }
agent <- layer1.ui { class: up-lazy }
config <- layer1.ui { class: up-lazy }
host <- layer1.ui { class: up-lazy }
host <- workspaces { class: up }
workspaces -> layer1.split { class: down }

legend: "An arrow points from a folder to one it imports: solid when the import loads with the\nmodule (eager), dashed when a getter or a call loads it later (lazy).\nGrey: down the layers, as ADR-026 allows.\nAn arrow to a band: imports that many of its folders.\nOrange: the 17 upward imports tools/layering/layers.ts lists, one arrow per pair of folders (#936 removes them).\nEager cycle, closed only by orange arrows: about/, actors/, config/, ctl/, host/, workspaces/.\nvimma.js imports every folder drawn here.\ncore/ is imported by every folder drawn here except omarchy/ and start/." { class: legend }
