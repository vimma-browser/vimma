# Vimma's running system: the processes, what talks to what, and the trust boundaries between
# them. ARCHITECTURE.md, "The running system", describes the same picture in words. Render with
# npm run diagrams (tools/diagrams/render.ts), which appends the light or dark palette.
#
# Laid out by hand on D2's grid, so that each arrow is a short straight line: the desktop and
# local programs on the left, Vimma's processes in the middle, the network on the right. Within
# the parent process the window modules sit at the top, next to the content process, the desktop
# and the update host; the agent sits at the bottom, next to the agent CLIs and the model
# providers. A `hole` keeps a grid cell empty.

grid-columns: 3
horizontal-gap: 40

classes: {
  hole: { label: ""; width: 10; height: 10; style: { fill: transparent; stroke: transparent } }
  wrap: { label: ""; grid-columns: 1; horizontal-gap: 0; vertical-gap: 50; style: { fill: transparent; stroke: transparent } }
  zone: {
    style: {
      fill: ${zone-app}
      stroke: ${box-line}
      stroke-dash: 4
      border-radius: 8
      font-color: ${muted}
      font-size: 21
      bold: true
    }
  }
  process: {
    style: {
      fill: ${box}
      stroke: ${box-line}
      border-radius: 6
      font-color: ${text}
      font-size: 21
      bold: true
    }
  }
  module: {
    style: {
      fill: ${bg}
      stroke: ${box-line}
      border-radius: 4
      font-color: ${text}
      font-size: 21
    }
  }
  gate: {
    style: {
      fill: ${accent-fill}
      stroke: ${accent}
      stroke-width: 2
      border-radius: 4
      font-color: ${text}
      font-size: 21
    }
  }
  outside: {
    style: {
      fill: ${bg}
      stroke: ${box-line}
      border-radius: 4
      font-color: ${text}
      font-size: 21
    }
  }
  flow: {
    style: {
      stroke: ${line}
      font-color: ${muted}
      font-size: 18
    }
  }
  gated: {
    style: {
      stroke: ${accent}
      stroke-width: 2
      font-color: ${muted}
      font-size: 18
    }
  }
}

west: {
  class: wrap
  desktop: "Desktop: strict parsing" {
    class: zone
    label.near: outside-top-left
    grid-columns: 1
    grid-gap: 24
    files: "config.toml, Omarchy\ncolors.toml (polled)" { class: outside }
    hook: "Omarchy theme-set hook\n(-vimma-reload-theme)" { class: outside }
    hypr: "Hyprland (IPC:\nrequests and events)" { class: outside }
  }
  local: "Local programs: token on 127.0.0.1" {
    class: zone
    label.near: outside-top-left
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 50
    vertical-gap: 40
    h1 { class: hole }
    scripts: "vimma-ctl, e2e\n(full role)" { class: outside }
    hosts: "AI agent host\n(MCP client)" { class: outside }
    mcp: "vimma-ctl mcp\n(agent role)" { class: outside }
    h2 { class: hole }
    clis: "Agent CLIs (Claude Code,\nCodex, Gemini), run by\nagent/ with a ticket" { class: outside }
  }
}

app: "Vimma (one application)" {
  class: zone
  label.near: outside-top-left
  grid-columns: 1
  horizontal-gap: 40
  vertical-gap: 80
  content: "Content processes (sandboxed)" {
    class: process
    label.near: outside-top-left
    style.fill: ${zone-page}
    style.stroke: ${zone-page-line}
    child: "actors/: VimmaChild,\none per frame" { class: module }
  }
  parent: "Parent process (privileged)" {
    class: process
    label.near: outside-bottom-right
    grid-columns: 1
    grid-gap: 40
    chrome: "vimma.js, host/, ui/,\nworkspaces/, split/,\nconfig/ … with core/" { class: module }
    ctl: "ctl/: control server\nand AgentGate" { class: gate }
    agent: "agent/: built-in agent" { class: module }
  }
}

east: {
  class: wrap
  net: "Network: HTTPS, signed updates" {
    class: zone
    label.near: outside-top-left
    grid-columns: 1
    grid-gap: 40
    updates: "updates.vimma.dev\n(signed manifest)" { class: outside }
    release: "Release pipeline\n(GitHub Actions)" { class: outside }
    models: "Model providers\n(Anthropic, OpenAI-\ncompatible; HTTP\nonly when local)" { class: outside }
  }
  legend: "Blue arrow: to ctl/, past the\nsocket's token or the agent gate\nYellow box: sandboxed, beside\nuntrusted pages\nDashed box: a trust boundary" {
    shape: text
    style: { font-color: ${muted}; font-size: 20 }
  }
}

west.local.hosts -> west.local.mcp: "stdio" { class: flow }
west.local.clis -> west.local.mcp: "stdio" { class: flow }
west.local.mcp -> app.parent.ctl { class: gated }
west.local.scripts -> app.parent.ctl { class: gated }
app.parent.agent -> west.local.clis { class: flow }
app.parent.agent -> app.parent.ctl: "same gate" { class: gated }
app.parent.ctl -> app.parent.chrome { class: flow }
app.parent.chrome <-> app.content.child: "actor messages" { class: flow }
app.parent.agent -> east.net.models { class: flow }
app.parent.chrome -> east.net.updates { class: flow }
east.net.release -> east.net.updates: "publishes" { class: flow }
west.desktop.files -> app.parent.chrome { class: flow }
west.desktop.hook -> app.parent.chrome { class: flow }
app.parent.chrome <-> west.desktop.hypr { class: flow }
