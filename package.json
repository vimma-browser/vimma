{
  "name": "vimma",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "npm run sync-core && tsc -p tsconfig.json && tsc -p tools/tsconfig.json",
    "lint": "eslint . && prettier --check . && npm run md-wording && npm run comment-wording && npm run spec-lint && npm run arch-lint && npm run layering && npm run diagrams:check && npm run changelog-lint",
    "md-wording": "node tools/md-wording/process-wording.ts",
    "comment-wording": "node tools/md-wording/comment-wording.ts",
    "spec-lint": "node tools/spec-lint/spec-lint.ts",
    "changelog-lint": "node tools/release/changelog.mjs check CHANGELOG.md",
    "arch-lint": "node tools/arch-lint/arch-lint.ts",
    "layering": "node tools/layering/layering.ts",
    "diagrams": "node tools/diagrams/module-graph.ts && node tools/diagrams/render.ts",
    "diagrams:check": "node tools/diagrams/module-graph.ts --check && node tools/diagrams/render.ts --check",
    "spec-status": "node tools/spec-lint/spec-status.ts",
    "format": "prettier --write .",
    "gen-docs": "node tools/gen-docs.ts && prettier --log-level warn --write docs/bindings.md docs/bindings.json",
    "sync-core": "node tools/sync-core.mjs",
    "version-files": "node tools/version-files/version-files.mjs",
    "import": "tools/upstream/verify-source.sh --require && npm run sync-core && npm run version-files && node tools/import/restore-patched.mjs && surfer config brand vimma && surfer import && node tools/import/link-update-certs.mjs && SURFER_MOZCONFIG_ONLY=1 surfer build",
    "start": "node tools/start.mjs",
    "build": "node tools/build.ts",
    "mochitest": "node tools/mochitest.mjs",
    "e2e": "node tools/e2e/e2e.mjs",
    "sites": "node tools/sites/sites.ts",
    "verify-source": "tools/upstream/verify-source.sh",
    "lane:setup": "node tools/lanes/lane-setup.ts",
    "lane:teardown": "node tools/lanes/lane-teardown.ts",
    "test:py": "python3 -m unittest discover -s tools/upstream",
    "license-check": "node tools/license-check/license-check.ts",
    "security-links": "node tools/security/check-doc-links.ts",
    "license-check:crates": "node tools/license-check/cargo-license-check.ts",
    "bench": "node tools/bench/bench.ts",
    "agent-bench": "node tools/agent-bench/agent-bench.ts",
    "mutation": "stryker run",
    "gen-agent-tools": "node tools/gen-agent-tools.ts",
    "gen-brandings": "node tools/branding/brandings.ts",
    "gen-update-keys": "node tools/update/gen-update-keys.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "@zen-browser/surfer": "1.14.9",
    "ajv": "^8.20.0",
    "amaro": "^1.3.0",
    "eslint": "^10.14.0",
    "espree": "^11.2.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "qs": "^6.17.0",
    "minimatch": "^11.0.4"
  }
}
