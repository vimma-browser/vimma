{
  "name": "vimma",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "npm run sync-core && tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check . && npm run md-wording && npm run comment-wording && npm run spec-lint && npm run changelog-lint",
    "md-wording": "node tools/md-wording/process-wording.mjs",
    "comment-wording": "node tools/md-wording/comment-wording.mjs",
    "spec-lint": "node tools/spec-lint/spec-lint.mjs",
    "changelog-lint": "node tools/release/changelog.mjs check CHANGELOG.md",
    "spec-status": "node tools/spec-lint/spec-status.mjs",
    "format": "prettier --write .",
    "gen-docs": "node tools/gen-docs.mjs && prettier --log-level warn --write docs/bindings.md docs/bindings.json",
    "sync-core": "node tools/sync-core.mjs",
    "version-files": "node tools/version-files/version-files.mjs",
    "import": "tools/upstream/verify-source.sh --require && npm run sync-core && npm run version-files && node tools/import/restore-patched.mjs && surfer config brand vimma && surfer import && SURFER_MOZCONFIG_ONLY=1 surfer build",
    "start": "node tools/start.mjs",
    "build": "node tools/build.mjs",
    "mochitest": "node tools/mochitest.mjs",
    "e2e": "node tools/e2e/e2e.mjs",
    "sites": "node tools/sites/sites.mjs",
    "verify-source": "tools/upstream/verify-source.sh",
    "lane:setup": "node tools/lanes/lane-setup.mjs",
    "lane:teardown": "node tools/lanes/lane-teardown.mjs",
    "test:py": "python3 -m unittest discover -s tools/upstream",
    "license-check": "node tools/license-check/license-check.mjs",
    "security-links": "node tools/security/check-doc-links.mjs",
    "license-check:crates": "node tools/license-check/cargo-license-check.mjs",
    "bench": "node tools/bench/bench.mjs",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@zen-browser/surfer": "1.14.9",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "qs": "^6.17.0"
  }
}
