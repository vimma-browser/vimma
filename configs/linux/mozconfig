# Optimise builds
ac_add_options --enable-application=browser
ac_add_options --enable-hardening
ac_add_options --enable-rust-simd
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --with-ccache=sccache
ac_add_options --disable-debug

# No debug symbols (#1572). Firefox's default full DWARF (-gdwarf-4, rustc -Cdebuginfo=2) made
# rustc hold 10.6 to 13.8 GB for gkrust alone: on a 16 GB hosted runner the build swapped 9 to
# 14 GB, its one stage under memory pressure. Without it the build peaks at 7.1 GB (Linux) and
# 11.8 GB (macOS cross) and does not swap. `mach package` strips the binaries either way, so no
# package carries symbols, and with no crash reporter nothing uploads or reads them. Comment the
# line out for a local build you want to debug.
ac_add_options --disable-debug-symbols
