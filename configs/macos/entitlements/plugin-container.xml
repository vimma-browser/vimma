<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
     Entitlements of Contents/MacOS/plugin-container.app, the content processes, in a Developer
     ID release: Firefox 158.0's (and 159.0's)
     security/mac/hardenedruntime/production/plugin-container.xml.
-->
<plist version="1.0">
  <dict>
    <!-- Firefox needs to create executable pages with MAP_JIT -->
    <key>com.apple.security.cs.allow-jit</key><true/>
  </dict>
</plist>
