# Optimise builds
ac_add_options --enable-application=browser
ac_add_options --enable-hardening
ac_add_options --enable-rust-simd
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --with-ccache=sccache
ac_add_options --disable-debug
mk_add_options MOZ_MAKE_FLAGS="-j4"

# Apple Silicon only (docs/specs/macos-build.md, decision 3). macos.yml cross-compiles this on
# Linux; --enable-bootstrap fetches the macOS SDK, clang and the DMG tools. On an Apple Silicon
# Mac the target is the host, so a native build is unchanged.
ac_add_options --target=aarch64-apple-darwin

# Names the app bundle dev.vimma.browser with MOZ_MACBUNDLE_ID in
# src/browser/branding/vimma/configure.sh; Firefox's default distribution id would make it
# org.mozilla.dev.vimma.browser. macOS only, so Linux keeps org.mozilla.
ac_add_options --with-distribution-id=dev.vimma
