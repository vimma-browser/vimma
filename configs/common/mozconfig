ac_add_options --with-app-name=${binName}
# No MOZ_USER_DIR (Surfer's template exports it): configure reads only --with-user-appdir, so the
# export did nothing. Profiles live under vendor/name (~/.config/vimma/vimma); any non-default
# --with-user-appdir forces the legacy ~/.vimma/vimma home and would move them (spec m0-branding).
export MOZ_APP_BASENAME=${name}
export MOZ_DISTRIBUTION_ID=${appId}

# Uncomment if builds are too resource hungry
# mk_add_options MOZ_MAKE_FLAGS="-j4"
# ac_add_options --enable-linker=gold

# Misc
export MOZ_STUB_INSTALLER=1
export MOZ_INCLUDE_SOURCE_INFO=1
# Change the below repository to your GitHub repository.
export MOZ_SOURCE_REPO=https://github.com/vimma-browser/vimma
export MOZ_SOURCE_CHANGESET=${changeset}

# Bootstrap
ac_add_options --enable-bootstrap

# Mozilla services (docs/specs/m0-mozilla-services.md). No crash reporter: its server is
# crash-reports.mozilla.com and no pref changes that; M6 brings opt-in reporting to our own.
ac_add_options --disable-crashreporter
# Telemetry does not upload because MOZILLA_OFFICIAL is unset (MOZ_TELEMETRY_REPORTING defaults
# to it). MOZ_DATA_REPORTING is computed by configure, so neither can be set with mk_add_options.

# App version (docs/specs/m0-app-version.md). Surfer writes displayVersion into both stock
# browser/config/version{,_display}.txt; configure reads these instead (npm run version-files):
# version.txt is the Firefox version (appinfo.version), version_display.txt is Vimma's.
ac_add_options --with-version-file-path=browser/config/vimma
# configure silently falls back to Surfer's 0.1.0 if these are missing, so fail loudly instead.
for _vimma_version_file in version.txt version_display.txt; do
  if [ ! -s "$topsrcdir/browser/config/vimma/$_vimma_version_file" ]; then
    echo "mozconfig: browser/config/vimma/$_vimma_version_file is missing; run 'npm run import'" >&2
    exit 1
  fi
done
unset _vimma_version_file

# App updates (docs/specs/m0-updater.md, m6a-updater.md §3). Firefox's updater is built only
# when VIMMA_UPDATES=1, which the release and nightly jobs set: a source or dev build would offer
# itself every release (its build ID is newer) and only adds traffic to the update host. Without
# it, application.ini has no [AppUpdate] URL, the About dialog shows the version only and
# Settings no update controls. With it, the updater embeds Vimma's update certificates
# (toolkit/mozapps/update/updater/moz-build.patch), which `npm run import` links from
# configs/updater/; a tree without them would fall back to Mozilla's test keys (dep1.der), so
# the build stops instead.
case "${VIMMA_UPDATES:-}" in
  "" | 1) ;;
  *)
    echo "mozconfig: VIMMA_UPDATES must be 1 or unset, not '$VIMMA_UPDATES'" >&2
    exit 1
    ;;
esac
if [ "${VIMMA_UPDATES:-}" = 1 ]; then
  for _vimma_cert in primary.der secondary.der; do
    if [ ! -s "$topsrcdir/toolkit/mozapps/update/updater/vimma/$_vimma_cert" ]; then
      echo "mozconfig: VIMMA_UPDATES=1 needs toolkit/mozapps/update/updater/vimma/$_vimma_cert," \
        "linked from configs/updater/ by npm run import" \
        "(docs/runbook/ci-update-signing-keys-and-the-update-host.md, \"Update signing keys and the update host\")" >&2
      exit 1
    fi
    # engine/ sits in the repository: a stale file or a link to another checkout, from a build
    # that skipped npm run import, would embed other keys than the committed ones.
    if ! cmp -s "$topsrcdir/toolkit/mozapps/update/updater/vimma/$_vimma_cert" \
      "$topsrcdir/../configs/updater/$_vimma_cert"; then
      echo "mozconfig: toolkit/mozapps/update/updater/vimma/$_vimma_cert is not" \
        "configs/updater/$_vimma_cert; run npm run import" >&2
      exit 1
    fi
  done
  unset _vimma_cert
  ac_add_options --enable-updater
else
  # The artifact build turns the line below into a comment; the no-op keeps this branch valid.
  :
  ac_add_options --disable-updater
fi

# Google Safe Browsing key (docs/specs/m0-safebrowsing-key.md): only when the key file exists,
# so keyless builds keep working; Vimma then defaults Safe Browsing off (MozillaServices.sys.mjs).
# CI passes a temp file in VIMMA_SAFEBROWSING_KEYFILE. configure reads the file itself and logs
# only yes/no; never echo the key here.
# A VIMMA_SAFEBROWSING_KEYFILE that does not exist is an error, not a silent keyless build.
if [ -n "$VIMMA_SAFEBROWSING_KEYFILE" ] && [ ! -f "$VIMMA_SAFEBROWSING_KEYFILE" ]; then
  echo "mozconfig: VIMMA_SAFEBROWSING_KEYFILE is set but names no file" >&2
  exit 1
fi
_vimma_sb_keyfile="${VIMMA_SAFEBROWSING_KEYFILE:-$HOME/.config/vimma/keys/safebrowsing}"
if [ -f "$_vimma_sb_keyfile" ]; then
  ac_add_options --with-google-safebrowsing-api-keyfile="$_vimma_sb_keyfile"
fi
unset _vimma_sb_keyfile
