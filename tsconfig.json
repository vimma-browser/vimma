{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "packages/*/src/**/*.mjs",
    "src/**/vimma/**/*.mjs",
    "src/browser/base/content/vimma/vimma.js",
    "types/*.d.ts"
  ],
  "exclude": ["src/browser/base/content/vimma/core/", "packages/vimma-core/src/vendor/"]
}
