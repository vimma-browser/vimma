# No package's install scripts run, in CI, lanes or on a developer's machine: nothing Vimma
# depends on needs one, and an install script is the usual way a compromised package runs code
# (docs/specs/build-supply-chain.md, decision 17;
# docs/security/14-build-and-release-supply-chain.md, B4). `npm run <script>` is unaffected.
ignore-scripts=true
