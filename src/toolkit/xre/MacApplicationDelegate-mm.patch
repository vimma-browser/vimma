   LOG_STARTUP_RUN_LOOP_EVENT("urls");
+  NSString* vimmaFrom =
+      VimmaSenderNames(NSAppleEventManager.sharedAppleEventManager.currentAppleEvent);
+  if (sLaunchStatus == LaunchStatus::CollectingURLs) VimmaSetColdStartNames(vimmaFrom);
   nsTArray<const char*> args([urls count] * 2 + 2);
   // Placeholder for unused program name.
   args.AppendElement(nullptr);
@@ -520,6 +553,10 @@ - (BOOL)openURLs:(NSArray<NSURL*>*)urls {
