+// Vimma (app-routes, decision 11): a kAEGetURL sender's bundle identifier and,
+// unless sandboxed, executable name, lower-cased, for [[routes]] app rules.
+static NSString* VimmaToken(NSString* aName) {
+  NSString* lower = aName.lowercaseString;
+  return [lower rangeOfString:@"^[a-z0-9][a-z0-9._+-]{0,63}\\z" options:NSRegularExpressionSearch]
+                 .length
+             ? lower
+             : nil;
+}
+
+static NSString* VimmaSenderNames(NSAppleEventDescriptor* aEvent) {
+  if (aEvent.eventClass != kInternetEventClass || aEvent.eventID != kAEGetURL) return nil;
+  pid_t pid = [aEvent attributeDescriptorForKeyword:keySenderPIDAttr].int32Value;
+  if (pid <= 0 || pid == getpid()) return nil;
+  NSRunningApplication* app = [NSRunningApplication runningApplicationWithProcessIdentifier:pid];
+  if (!app.bundleIdentifier) return nil;  // not an app bundle: no names
+  BOOL boxed = [aEvent attributeDescriptorForKeyword:keySenderApplicationSandboxed].booleanValue;
+  NSString* bundle = VimmaToken(app.bundleIdentifier);
+  NSString* exe = boxed ? nil : VimmaToken(app.executableURL.lastPathComponent);
+  return bundle && exe ? [@[ bundle, exe ] componentsJoinedByString:@","] : (bundle ?: exe);
+}
+
+// Vimma: a cold start's names go in VIMMA_FROM, never an inherited one, and
+// only while every link of the start came from the same first event.
+static void VimmaSetColdStartNames(NSString* aNames) {
+  static bool sFirst = true;
+  aNames && sFirst ? setenv("VIMMA_FROM", aNames.UTF8String, 1) : unsetenv("VIMMA_FROM");
+  sFirst = false;
+}
+
