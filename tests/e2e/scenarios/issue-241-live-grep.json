{
  "name": "issue-241-live-grep",
  "issue": 241,
  "description": "Live grep (docs/specs/live-grep.md): three fixture pages in one workspace; ctrl+b f g and `credit` list every matching line with its tab and line number, the best result next to the prompt at the bottom, the preview on the right with the matched line highlighted; Enter selects that tab and the match, in normal mode. The status bar shows the fixture server's fixed port (28471).",
  "timeoutSeconds": 90,
  "steps": [
    {
      "wait-for-state": {
        "workspace": "main"
      },
      "timeoutSeconds": 20
    },
    {
      "open": "fixture:grep-policy.html"
    },
    {
      "open": "fixture:grep-billing.html"
    },
    {
      "open": "fixture:grep-notes.html"
    },
    {
      "wait-for-state": {
        "tabs": [
          {},
          {
            "title": "Security policy"
          },
          {
            "title": "Billing help"
          },
          {
            "title": "Release notes draft",
            "selected": true
          }
        ]
      }
    },
    {
      "keys": "ctrl+b f g"
    },
    {
      "wait-for-state": {
        "mode": "help"
      }
    },
    {
      "keys": "c r e d i t"
    },
    {
      "wait-for-state": {
        "mode": "help",
        "grep": {
          "busy": false
        }
      }
    },
    {
      "screenshot": "live-grep"
    },
    {
      "keys": "up up up"
    },
    {
      "wait-for-state": {
        "mode": "help",
        "grep": {
          "busy": false
        }
      }
    },
    {
      "keys": "enter"
    },
    {
      "wait-for-state": {
        "mode": "normal",
        "grep": null
      }
    },
    {
      "screenshot": "live-grep-jump"
    }
  ]
}
