{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "versioning": "always-bump-patch",
  "draft": true,
  "draft-pull-request": true,
  "force-tag-creation": true,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "upstream", "section": "Changed" },
    { "type": "deps", "section": "Changed" },
    { "type": "revert", "section": "Changed" },
    { "type": "refactor", "section": "Changed", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "surfer.json",
          "jsonpath": "$.brands.vimma.release.displayVersion"
        }
      ]
    }
  }
}
